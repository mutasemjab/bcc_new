rules_version = '2';

// BCC Chat — Firestore security rules.
// Every read/write is checked server-side; the client is never trusted.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function changedKeys() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function onlyChanges(keys) { return changedKeys().hasOnly(keys); }

    // True if either user has blocked the other.
    function blockedBetween(a, b) {
      return exists(/databases/$(database)/documents/users/$(a)/blocked/$(b))
          || exists(/databases/$(database)/documents/users/$(b)/blocked/$(a));
    }

    // ── Users ──────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && uid() == userId
        && request.resource.data.get('name', '').size() <= 40
        // A profile phone must be the SMS-verified number of this account
        // (so nobody can claim someone else's number).
        && (request.resource.data.get('phone', null) == null
            || request.resource.data.phone == request.auth.token.get('phone_number', '')
            || (resource != null && request.resource.data.phone == resource.data.get('phone', null)));
      allow delete: if false;

      // Messages scheduled for later — private to their author.
      match /scheduled/{scheduledId} {
        allow read, write: if signedIn() && uid() == userId;
      }

      // My block list — only I can see or change it.
      match /blocked/{blockedId} {
        allow read, write: if signedIn() && uid() == userId;
      }

      // Starred messages and appointments — private to me.
      match /starred/{starId} {
        allow read, write: if signedIn() && uid() == userId;
      }
      match /appointments/{appointmentId} {
        allow read, write: if signedIn() && uid() == userId;
      }
    }

    // ── Presence (online / last seen) ─────────────────────────────────
    // Hidden from anyone this user has blocked. Values the user chose to hide
    // are simply never written.
    match /presence/{userId} {
      allow read: if signedIn()
        && !exists(/databases/$(database)/documents/users/$(userId)/blocked/$(uid()));
      allow write: if signedIn() && uid() == userId;
    }

    // ── Chats (1:1 and groups) ─────────────────────────────────────────
    match /chats/{chatId} {
      function isMember() { return uid() in resource.data.participants; }
      function isAdmin() { return uid() in resource.data.get('admins', []); }
      function isGroup() { return resource.data.get('isGroup', false) == true; }

      function validDirectCreate() {
        let p = request.resource.data.participants;
        return request.resource.data.get('isGroup', false) == false
          && p.size() == 2
          && chatId in [p[0] + '_' + p[1], p[1] + '_' + p[0]];
      }

      function validGroupCreate() {
        let d = request.resource.data;
        return d.isGroup == true
          && d.createdBy == uid()
          && d.admins == [uid()]
          && d.name is string && d.name.size() > 0 && d.name.size() <= 60
          && d.participants.size() <= 256;
      }

      // Sending messages, typing, read receipts, pin, mute.
      function memberActivity() {
        return request.resource.data.participants == resource.data.participants
          && onlyChanges(['lastMessage', 'updatedAt', 'unread', 'typing', 'pinnedBy', 'mutedBy', 'pinnedMessages',
                          'clearedAt', 'deletedAt', 'autoClear'])
          // "Clear chat" / "Delete chat" / auto-clear only ever touch my own entry.
          && ownKeyOnly('clearedAt') && ownKeyOnly('deletedAt') && ownKeyOnly('autoClear');
      }

      function adminEdit() {
        return isGroup() && isAdmin() && !resource.data.get('closed', false)
          && onlyChanges(['name', 'description', 'photoUrl', 'participants', 'admins', 'unread', 'lastMessage', 'updatedAt',
                         'invited', 'invitedBy', 'inviteCode', 'secret', 'invitedEmails'])
          // Admins are always public: an anonymous member can't be made admin.
          && !request.resource.data.get('admins', []).hasAny(request.resource.data.get('anonymous', {}).keys());
      }

      // The owner leaving ends the group for everyone.
      function endingGroup() {
        return isGroup() && resource.data.get('createdBy', '') == uid()
          && request.resource.data.closed == true
          && ownKeyOnly('clearedAt') && ownKeyOnly('deletedAt')
          && onlyChanges(['closed', 'closedAt', 'inviteCode', 'lastMessage', 'updatedAt', 'clearedAt', 'deletedAt']);
      }

      // My (verified) email was invited before I had an account.
      function myVerifiedEmail() {
        return request.auth.token.get('email_verified', false) == true ? request.auth.token.get('email', '') : '';
      }

      // Turn "invited by email" into a normal invitation for myself.
      function claimingEmailInvite() {
        let before = resource.data;
        let after = request.resource.data;
        let email = myVerifiedEmail();
        return isGroup() && email != '' && email in before.get('invitedEmails', [])
          && after.get('invitedEmails', []).toSet() == before.get('invitedEmails', []).toSet().difference([email].toSet())
          && after.get('invited', []).toSet() == before.get('invited', []).toSet().union([uid()].toSet())
          && ownKeyOnly('invitedBy')
          && onlyChanges(['invitedEmails', 'invited', 'invitedBy']);
      }

      // Someone who left a group may still clear / delete it from their list.
      function formerMemberCleanup() {
        return uid() in resource.data.get('formerMembers', [])
          && ownKeyOnly('clearedAt') && ownKeyOnly('deletedAt') && ownKeyOnly('unread')
          && onlyChanges(['clearedAt', 'deletedAt', 'unread']);
      }

      // Members may share the join link of a non-secret group.
      function memberSharesLink() {
        return isGroup() && !resource.data.get('secret', false) && !resource.data.get('closed', false)
          && onlyChanges(['inviteCode']);
      }

      // A member who left on their own comes back (non-secret, not ended).
      function rejoining() {
        let before = resource.data;
        let after = request.resource.data;
        return isGroup() && !before.get('secret', false) && !before.get('closed', false)
          && uid() in before.get('formerMembers', [])
          && after.participants.toSet() == before.participants.toSet().union([uid()].toSet())
          && after.get('admins', []) == before.get('admins', [])
          && after.get('formerMembers', []).toSet() == before.get('formerMembers', []).toSet().difference([uid()].toSet())
          && ownKeyOnly('anonymous') && ownKeyOnly('unread')
          && onlyChanges(['participants', 'formerMembers', 'unread', 'anonymous', 'lastMessage', 'updatedAt']);
      }

      // A member removing only themself; admin rights pass on if needed.
      function leaving() {
        let before = resource.data;
        let after = request.resource.data;
        let remainingAdmins = before.get('admins', []).toSet().difference([uid()].toSet());
        return isGroup()
          // The owner doesn't "leave" — leaving ends the group (endingGroup).
          && before.get('createdBy', '') != uid()
          && after.participants.toSet() == before.participants.toSet().difference([uid()].toSet())
          && (remainingAdmins.size() > 0
                ? after.admins.toSet() == remainingAdmins
                : after.admins.size() <= 1 && after.participants.toSet().hasAll(after.admins.toSet()))
          && after.get('formerMembers', []).toSet().difference(before.get('formerMembers', []).toSet()).hasOnly([uid()])
          && onlyChanges(['participants', 'admins', 'lastMessage', 'updatedAt', 'formerMembers']);
      }

      // A map field where only the caller's own key may change.
      function ownKeyOnly(field) {
        return request.resource.data.get(field, {}).diff(resource.data.get(field, {})).affectedKeys().hasOnly([uid()]);
      }

      // The caller adds only themself as a member (never anyone else, never admin).
      function addsOnlySelf() {
        let before = resource.data;
        let after = request.resource.data;
        return after.participants.toSet() == before.participants.toSet().union([uid()].toSet())
          && after.get('invited', []).toSet() == before.get('invited', []).toSet().difference([uid()].toSet())
          && after.get('admins', []) == before.get('admins', [])
          && ownKeyOnly('anonymous') && ownKeyOnly('invitedBy') && ownKeyOnly('unread');
      }

      // Invitee accepts (optionally anonymously).
      function acceptingInvite() {
        return isGroup() && uid() in resource.data.get('invited', []) && addsOnlySelf()
          && onlyChanges(['participants', 'invited', 'invitedBy', 'unread', 'anonymous', 'lastMessage', 'updatedAt']);
      }

      // Anyone holding the current join-link code may join.
      function joiningWithLink() {
        return isGroup() && resource.data.get('inviteCode', '') != '' && !resource.data.get('closed', false)
          && request.resource.data.get('joinCode', '') == resource.data.inviteCode
          && !(uid() in resource.data.participants) && addsOnlySelf()
          && onlyChanges(['participants', 'invited', 'invitedBy', 'unread', 'anonymous', 'lastMessage', 'updatedAt', 'joinCode']);
      }

      function decliningInvite() {
        return uid() in resource.data.get('invited', [])
          && request.resource.data.get('invited', []).toSet() == resource.data.get('invited', []).toSet().difference([uid()].toSet())
          && ownKeyOnly('invitedBy')
          && onlyChanges(['invited', 'invitedBy']);
      }

      // Reveal: stamps revealedAt with the server time.
      // Hide again: only when 24 hours have passed since the last reveal.
      function changingIdentity() {
        let wasAnon = uid() in resource.data.get('anonymous', {});
        let nowAnon = uid() in request.resource.data.get('anonymous', {});
        let revealed = resource.data.get('revealedAt', {});
        return isGroup() && ownKeyOnly('anonymous') && ownKeyOnly('revealedAt')
          && onlyChanges(['anonymous', 'revealedAt', 'lastMessage', 'updatedAt'])
          && (
            (wasAnon && !nowAnon && request.resource.data.revealedAt[uid()] == request.time)
            || (!wasAnon && nowAnon
                && !isAdmin() // admins must stay public
                && !changedKeys().hasAny(['revealedAt'])
                && (!(uid() in revealed) || request.time > revealed[uid()] + duration.value(24, 'h')))
          );
      }

      // Plain field access so the "my invitations" query (array-contains) is provable.
      allow read: if signedIn() && (resource == null || isMember() || uid() in resource.data.invited
                                     || uid() in resource.data.formerMembers
                                     || (request.auth.token.email_verified == true
                                         && request.auth.token.email in resource.data.invitedEmails));
      allow create: if signedIn()
        && uid() in request.resource.data.participants
        && (validDirectCreate() || validGroupCreate());
      allow update: if signedIn() && (
        (isMember() && (memberActivity() || adminEdit() || leaving() || changingIdentity()
                        || endingGroup() || memberSharesLink()))
        || acceptingInvite() || decliningInvite() || joiningWithLink() || rejoining() || formerMemberCleanup()
        || claimingEmailInvite()
      );
      allow delete: if false;

      // ── Messages ─────────────────────────────────────────────────────
      match /messages/{messageId} {
        function chatPath() { return /databases/$(database)/documents/chats/$(chatId); }
        function member() { return signedIn() && uid() in get(chatPath()).data.participants; }

        allow read: if member();

        // getAfter: the chat may be created in the same batch.
        // get: a member leaving a group posts the "X left" notice.
        // 1:1 chat ids are "uidA_uidB": nobody can message across a block.
        function directBlocked() {
          let ids = chatId.split('_');
          return ids.size() == 2 && blockedBetween(ids[0], ids[1]);
        }

        // Photos / videos / files from an anonymous member wait for an admin.
        function anonymousMediaApproved() {
          let chat = getAfter(chatPath()).data;
          return !(uid() in chat.get('anonymous', {}))
            || !(request.resource.data.type in ['image', 'video', 'file'])
            || request.resource.data.get('pendingApproval', false) == true;
        }

        allow create: if signedIn()
          && request.resource.data.senderId == uid()
          && (uid() in getAfter(chatPath()).data.participants || uid() in get(chatPath()).data.participants)
          && request.resource.data.get('text', '').size() <= 4096
          && !directBlocked()
          // Ended group: read-only (only the "ended" notice itself).
          && (request.resource.data.type == 'system' || !getAfter(chatPath()).data.get('closed', false))
          && anonymousMediaApproved();

        // Delete for everyone: within 2 hours. Edit text: within 15 minutes.
        function senderChangeAllowed() {
          let deleting = request.resource.data.get('deletedForEveryone', false) == true
                      && resource.data.get('deletedForEveryone', false) == false;
          return deleting
            ? request.time < resource.data.createdAt + duration.value(2, 'h')
            : (!changedKeys().hasAny(['text']) || request.time < resource.data.createdAt + duration.value(15, 'm'));
        }

        allow update: if member() && (
          // Sender: edit or delete for everyone.
          (resource.data.senderId == uid()
             && request.resource.data.senderId == resource.data.senderId
             && request.resource.data.type == resource.data.type
             && senderChangeAllowed())
          // Anyone in the chat: receipts, reactions, delete-for-me.
          || onlyChanges(['readBy', 'deliveredTo', 'reactions', 'deletedFor'])
          // Anyone in the chat: vote on a poll (only their own entry).
          || (resource.data.type == 'poll'
              && onlyChanges(['pollVotes'])
              && request.resource.data.get('pollVotes', {}).diff(resource.data.get('pollVotes', {})).affectedKeys().hasOnly([uid()]))
          // Admins: approve / reject an anonymous member's media.
          || (uid() in get(chatPath()).data.get('admins', [])
              && onlyChanges(['pendingApproval', 'approvedBy', 'rejected']))
          // Anyone in the chat: mark a view-once message as opened (only themself).
          || (resource.data.get('viewOnce', false) == true
              && onlyChanges(['openedBy'])
              && request.resource.data.openedBy.toSet().difference(resource.data.get('openedBy', []).toSet()) == [uid()].toSet())
        );
        allow delete: if false;
      }
    }

    // ── Group join links ──────────────────────────────────────────────
    // The code is unguessable, so knowing it is what grants the preview.
    match /groupInvites/{code} {
      function mayShare(cid) {
        let chat = get(/databases/$(database)/documents/chats/$(cid)).data;
        return uid() in chat.get('admins', [])
          || (uid() in chat.participants && !chat.get('secret', false) && !chat.get('closed', false));
      }
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && mayShare(request.resource.data.chatId);
      allow delete: if signedIn() && mayShare(resource.data.chatId);
    }

    // ── Stories ────────────────────────────────────────────────────────
    match /statuses/{statusId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.userId == uid()
        && request.resource.data.type in ['text', 'image'];
      allow update: if signedIn() && (
        resource.data.userId == uid()
        || (onlyChanges(['viewers'])
            && request.resource.data.viewers.toSet().difference(resource.data.viewers.toSet()) == [uid()].toSet())
      );
      allow delete: if signedIn() && resource.data.userId == uid();
    }

    // ── Calls (signalling) ─────────────────────────────────────────────
    match /calls/{callId} {
      allow read: if signedIn() && uid() in resource.data.participants;
      allow create: if signedIn()
        && request.resource.data.callerId == uid()
        && uid() in request.resource.data.participants
        && request.resource.data.status == 'ringing'
        && (request.resource.data.get('isGroup', false) == true
            || request.resource.data.participants.size() != 2
            || !blockedBetween(request.resource.data.participants[0], request.resource.data.participants[1]));
      allow update: if signedIn()
        && uid() in resource.data.participants
        && onlyChanges(['joined', 'declined', 'status', 'startedAt', 'endedAt']);
      allow delete: if false;
    }
  }
}
